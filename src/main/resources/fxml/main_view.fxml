<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.procampo.controller.MainController"
            stylesheets="@../css/style.css">

    <!-- HEADER BAR -->
    <top>
        <VBox styleClass="header-bar" spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="ProCampo Desktop" styleClass="header-title"/>
                    <Label text="Sistema de Gestão e Consulta de Orçamentos Agropecuários" styleClass="header-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatusDb" text="Banco SQLite Ativo" style="-fx-text-fill: #a5d6a7; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT SIDEBAR / NAVIGATION -->
    <left>
        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20px 14px; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-pref-width: 240px;">
            <Label text="NAVEGAÇÃO" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-padding: 0 0 6px 4px;"/>
            
            <Button text="📁 Catálogo de Modelos" styleClass="btn-secondary" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showModelosView"/>
            <Button text="💲 Catálogo de Preços" styleClass="btn-secondary" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showItensView"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Label text="PORTABILIDADE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #a0aec0; -fx-padding: 0 0 6px 4px;"/>
            <Button text="📤 Exportar Banco (.db)" styleClass="btn-info" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleExportDb"/>
            <Button text="📥 Importar Banco (.db)" styleClass="btn-secondary" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleImportDb"/>
        </VBox>
    </left>

    <!-- CENTER AREA -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-padding: 24px;">
            <!-- CATÁLOGO DE MODELOS VIEW -->
            <VBox fx:id="viewModelos" spacing="16" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox>
                        <Label text="Catálogo de Modelos de Orçamento" styleClass="card-title"/>
                        <Label text="Consulte, filtre ou crie modelos de projetos rurais" styleClass="card-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Novo Modelo" styleClass="btn-primary" onAction="#handleNovoModelo"/>
                </HBox>

                <!-- FILTER BAR -->
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #edf2f7; -fx-border-radius: 8px;">
                    <TextField fx:id="txtBuscaModelo" promptText="Buscar por nome do projeto..." HBox.hgrow="ALWAYS" styleClass="text-field"/>
                    <ComboBox fx:id="cbCategoriaModelo" promptText="Categoria" prefWidth="200" styleClass="combo-box"/>
                    <Button text="Filtrar" styleClass="btn-secondary" onAction="#handleBuscarModelos"/>
                    <Button text="Limpar" styleClass="btn-secondary" onAction="#handleLimparFiltrosModelo"/>
                </HBox>

                <!-- TABLE VIEW MODELOS -->
                <TableView fx:id="tblModelos" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colModNome" text="Nome do Projeto / Modelo" prefWidth="300"/>
                        <TableColumn fx:id="colModCategoria" text="Categoria" prefWidth="180"/>
                        <TableColumn fx:id="colModCiclo" text="Ciclo Produtivo" prefWidth="130"/>
                        <TableColumn fx:id="colModProdutividade" text="Área / Produtividade" prefWidth="200"/>
                        <TableColumn fx:id="colModTotal" text="Total Calculado (R$)" prefWidth="150" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>
                    </columns>
                </TableView>

                <!-- BOTTOM ACTIONS -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Excluir Modelo" styleClass="btn-danger" onAction="#handleExcluirModelo"/>
                    <Button text="🔍 Detalhar Orçamento e Etapas" styleClass="btn-primary" onAction="#handleDetalharModelo"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
