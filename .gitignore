# ===== Build (Maven) =====
target/
build/
dependency-reduced-pom.xml

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Exceções: wrapper do Maven e distribuição pronta (dist/)
!.mvn/wrapper/maven-wrapper.jar
!dist/**/*.jar
!dist/*.zip

# Banco de dados gerado ao executar pela IDE (o dist já leva o seu)
/orcamentos.db

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ===== IDEs / SO =====
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
nbproject/
Thumbs.db
desktop.ini
.DS_Store
~$*
